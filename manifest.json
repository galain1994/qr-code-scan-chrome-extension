{
  "name": "__MSG_extName__",
  "version": "1.1.0",
  "manifest_version": 3,
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "action": {
    "default_icon": "icon.png",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["jsQR.js", "quagga.min.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
